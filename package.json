{
  "name": "sigil-sealed-auction",
  "private": true,
  "version": "0.1.0",
  "description": "Sigil — a private sealed-bid auction dApp on Midnight. Commit your bid, let the ledger keep the secret, reveal only what the auction needs to know.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "compact:compile": "compactc compile contracts/auction.compact managed/auction",
    "postinstall": "node patch-sdk.cjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.19.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-network-id": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-protocol": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-types": "^5.0.0-beta.8",
    "@midnight-ntwrk/midnight-js-utils": "^5.0.0-beta.8",
    "buffer": "^6.0.3",
    "fp-ts": "^2.16.11",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.0.3"
  }
}